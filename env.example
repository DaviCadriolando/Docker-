name: tasks-app

services:
  db:
    image: postgres:16-alpine
    container_name: tasks-db
    restart: unless-stopped
    environment:
      POSTGRES_DB: ${POSTGRES_DB:?defina POSTGRES_DB no .env}
      POSTGRES_USER: ${POSTGRES_USER:?defina POSTGRES_USER no .env}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?defina POSTGRES_PASSWORD no .env}
      APP_DB_USER: ${APP_DB_USER:?defina APP_DB_USER no .env}
      APP_DB_PASSWORD: ${APP_DB_PASSWORD:?defina APP_DB_PASSWORD no .env}
    volumes:
      # Persistência: os dados sobrevivem a "docker compose down"
      - pgdata:/var/lib/postgresql/data
      # Script que cria o usuário da aplicação e as tabelas (roda só na 1ª vez)
      - ./db/init:/docker-entrypoint-initdb.d:ro
    networks:
      - backend
    # Sem "ports": o banco NÃO é exposto ao host, só acessível pela rede interna
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $${POSTGRES_USER} -d $${POSTGRES_DB}"]
      interval: 5s
      timeout: 5s
      retries: 10

  app:
    build:
      context: ./app
    image: tasks-api:1.0
    container_name: tasks-app
    restart: unless-stopped
    depends_on:
      db:
        condition: service_healthy
    environment:
      PORT: 3000
      DB_HOST: db
      DB_PORT: 5432
      DB_NAME: ${POSTGRES_DB}
      # A aplicação usa o usuário limitado, nunca o administrador
      DB_USER: ${APP_DB_USER}
      DB_PASSWORD: ${APP_DB_PASSWORD}
    ports:
      - "${APP_PORT:-3000}:3000"
    networks:
      - backend

networks:
  backend:
    name: tasks-backend
    driver: bridge

volumes:
  pgdata:
    name: tasks-pgdata
